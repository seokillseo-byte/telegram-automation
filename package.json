{
  "name": "telegram-automation",
  "version": "0.15.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "pnpm lint && pnpm test && pnpm build",
    "desktop:dev": "pnpm build && electron apps/desktop",
    "dist:win": "pnpm build && electron-builder --config electron-builder.json --win nsis --x64 --publish never",
    "smoke": "node scripts/smoke.mjs",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
